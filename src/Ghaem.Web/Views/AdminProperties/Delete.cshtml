@model Ghaem.Web.Models.Entities.Property
@{
    ViewData["Title"] = "حذف ملک";
    Layout = "_AdminLayout";
}
<h2 class="text-danger">حذف ملک</h2>
<h3>آیا از حذف این ملک مطمئن هستید؟</h3>
<div>
    <h4>@Model.Title</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">نوع</dt>
        <dd class="col-sm-10">@Model.PropertyType.GetDisplayName()</dd>
        
        <dt class="col-sm-2">معامله</dt>
        <dd class="col-sm-10">@Model.TransactionType.GetDisplayName()</dd>

        <dt class="col-sm-2">آدرس</dt>
        <dd class="col-sm-10">@Model.Address</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="حذف قطعی" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">بازگشت</a>
    </form>
</div>
