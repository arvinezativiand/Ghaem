@using Ghaem.Web.Models.Enums
@model Ghaem.Web.Models.Entities.Property
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Description.Substring(0, Math.Min(Model.Description.Length, 150));
    var canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/properties/{Model.Slug}";
    ViewData["CanonicalUrl"] = canonicalUrl;
}

@section Scripts {
    <!-- SEO Meta Tags -->
    <meta name="description" content="@ViewData["Description"]" />
    <link rel="canonical" href="@ViewData["CanonicalUrl"]" />
    <meta property="og:title" content="@Model.Title" />
    <meta property="og:description" content="@ViewData["Description"]" />
    <meta property="og:type" content="article" />
    <meta property="og:url" content="@ViewData["CanonicalUrl"]" />
    @if(Model.Images.Any()) {
        <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/images/properties/{Model.Images.OrderBy(i=>i.DisplayOrder).First().FileName}")" />
    }

    <script>
        function updateMainImage(src) {
            document.getElementById('mainGalleryImage').src = src;
            document.querySelectorAll('.gallery-thumb').forEach(el => el.classList.remove('active'));
            event.target.classList.add('active');
        }
    </script>
}

<div class="row mt-4 mb-3">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">خانه</a></li>
                <li class="breadcrumb-item"><a asp-action="Properties" class="text-decoration-none">املاک</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <h1 class="mb-2 fw-bold text-primary-dark">@Model.Title</h1>
        <p class="text-muted fs-5 mb-4"><i class="bi bi-geo-alt text-danger me-1"></i> @Model.Address</p>

        @if (Model.Images.Any())
        {
            var images = Model.Images.OrderBy(i => i.DisplayOrder).ToList();
            <div class="gallery-main">
                <img id="mainGalleryImage" src="~/images/properties/@images.First().FileName" alt="@Model.Title">
            </div>
            
            @if (images.Count > 1)
            {
                <div class="gallery-thumbs mb-4">
                    @foreach (var img in images)
                    {
                        var imgSrc = $"/images/properties/{img.FileName}";
                        <img src="@imgSrc" class="gallery-thumb @(img == images.First() ? "active" : "")" onclick="updateMainImage('@imgSrc')" alt="تصویر کوچک">
                    }
                </div>
            }
        }
        else
        {
            <div class="gallery-main mb-4 bg-light d-flex align-items-center justify-content-center">
                <i class="bi bi-image text-muted" style="font-size: 5rem;"></i>
            </div>
        }

        <div class="detail-box">
            <h4 class="mb-4 fw-bold text-primary-dark border-bottom pb-3"><i class="bi bi-card-text me-2"></i> توضیحات ملک</h4>
            <p style="white-space: pre-wrap; line-height: 2;" class="text-secondary">@Model.Description</p>
        </div>
    </div>
    
    <div class="col-lg-4">
        <!-- Price Box -->
        <div class="detail-box border-top border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <span class="badge property-badge position-static @(Model.TransactionType == TransactionType.Sale ? "badge-sale" : "badge-rent")">
                    @Model.TransactionType.GetDisplayName()
                </span>
                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                    <i class="bi bi-check-circle me-1"></i> @Model.Status.GetDisplayName()
                </span>
            </div>
            
            <h3 class="fw-bold text-accent mb-4 text-center">
                @if (Model.TransactionType == TransactionType.Sale)
                {
                    <text>@Model.SalePrice?.ToString("N0") <span class="fs-5 text-muted fw-normal">تومان</span></text>
                }
                else
                {
                    <div class="fs-4 mb-2">رهن: @Model.Deposit?.ToString("N0") <span class="fs-6 text-muted fw-normal">تومان</span></div>
                    <div class="fs-4">اجاره: @Model.MonthlyRent?.ToString("N0") <span class="fs-6 text-muted fw-normal">تومان</span></div>
                }
            </h3>
            
            <button class="btn btn-primary w-100 btn-lg shadow-sm mb-3">
                <i class="bi bi-telephone me-2"></i> تماس با مشاور
            </button>
        </div>

        <!-- Details Grid -->
        <div class="detail-box">
            <h5 class="fw-bold text-primary-dark mb-4 pb-2 border-bottom">مشخصات کلیدی</h5>
            <div class="row g-3">
                <div class="col-6">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-rulers detail-icon ms-0 me-3"></i>
                        <div>
                            <div class="text-muted small">متراژ</div>
                            <div class="fw-bold">@Model.Area متر</div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-house detail-icon ms-0 me-3"></i>
                        <div>
                            <div class="text-muted small">نوع ملک</div>
                            <div class="fw-bold">@Model.PropertyType.GetDisplayName()</div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-door-closed detail-icon ms-0 me-3"></i>
                        <div>
                            <div class="text-muted small">تعداد خواب</div>
                            <div class="fw-bold">@Model.BedroomCount</div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-building detail-icon ms-0 me-3"></i>
                        <div>
                            <div class="text-muted small">طبقه</div>
                            <div class="fw-bold">@Model.Floor از @Model.TotalFloors</div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-calendar-event detail-icon ms-0 me-3"></i>
                        <div>
                            <div class="text-muted small">سال ساخت</div>
                            <div class="fw-bold">@Model.ConstructionYear</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Amenities -->
        <div class="detail-box">
            <h5 class="fw-bold text-primary-dark mb-4 pb-2 border-bottom">امکانات</h5>
            <div class="d-flex flex-column gap-3">
                <div class="d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-p-circle me-2 text-muted"></i> پارکینگ</span>
                    @if(Model.HasParking){ <i class="bi bi-check-circle-fill text-success"></i> } else { <i class="bi bi-x-circle text-danger"></i> }
                </div>
                <div class="d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-box me-2 text-muted"></i> انباری</span>
                    @if(Model.HasStorage){ <i class="bi bi-check-circle-fill text-success"></i> } else { <i class="bi bi-x-circle text-danger"></i> }
                </div>
                <div class="d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-arrow-up-square me-2 text-muted"></i> آسانسور</span>
                    @if(Model.HasElevator){ <i class="bi bi-check-circle-fill text-success"></i> } else { <i class="bi bi-x-circle text-danger"></i> }
                </div>
            </div>
        </div>
    </div>
</div>
