@model Ghaem.Web.Models.ViewModels.PropertyFormViewModel
@{
    ViewData["Title"] = "افزودن ملک جدید";
    Layout = "_AdminLayout";
}
<h2>افزودن ملک جدید</h2>
<hr />
<form asp-action="Create" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_PropertyForm" model="Model" />
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">ثبت ملک</button>
        <a asp-action="Index" class="btn btn-secondary">بازگشت</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
