@{
    ViewData["Title"] = "ورود";
}
<div class="container py-5 mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
                <div class="text-center mb-5">
                    <h2 class="fw-bold text-dark mb-2">املاک قائم</h2>
                    <p class="text-muted small">ورود به پنل مدیریت</p>
                </div>
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger rounded-3 border-0 bg-danger bg-opacity-10 text-danger small mb-4 px-3 py-2">
                        @Html.ValidationSummary(false, "", new { @class = "mb-0 list-unstyled" })
                    </div>
                }
                
                <form method="post" asp-action="Login">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    
                    <div class="form-floating mb-4">
                        <input type="text" class="form-control rounded-3" id="username" name="username" placeholder="نام کاربری" required>
                        <label for="username" class="text-muted">نام کاربری</label>
                    </div>
                    
                    <div class="form-floating mb-5">
                        <input type="password" class="form-control rounded-3" id="password" name="password" placeholder="رمز عبور" required>
                        <label for="password" class="text-muted">رمز عبور</label>
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-3 fw-bold shadow-sm transition-all hover-shadow">
                        ورود به سیستم
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa; /* Slight off-white background to make the white card pop */
    }
    .form-floating > label {
        right: 0;
        left: auto;
        padding-right: 1rem;
        transform-origin: top right;
    }
    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: var(--primary-color);
        transform: scale(0.85) translateY(-0.5rem) translateX(0.15rem);
    }
    .form-control:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 0.25rem rgba(0, 0, 0, 0.05);
    }
    .hover-shadow:hover {
        transform: translateY(-2px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
    .transition-all {
        transition: all 0.3s ease;
    }
</style>
