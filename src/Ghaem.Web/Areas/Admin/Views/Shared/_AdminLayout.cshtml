<!DOCTYPE html>
<html lang="fa" dir="rtl">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - پنل مدیریت</title>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    </head>
    <body class="bg-light">
        <!-- Header -->
        <header>
            <nav class="navbar navbar-expand-lg admin-navbar fixed-top">
                <div class="container-fluid px-4 align-items-center">
                    <!-- Top Brand -->
                    <a class="navbar-brand d-flex align-items-center fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        داشبورد مدیریت
                    </a>

                    <div class="d-flex align-items-center order-lg-3 gap-3">
                        <a class="btn btn-dark btn-sm rounded-pill px-3 shadow-sm d-lg-none" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-box-arrow-up-right"></i> بازگشت
                        </a>
                        <button class="navbar-toggler border-0 p-1" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbarContent">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                    </div>

                    <div class="collapse navbar-collapse" id="adminNavbarContent">
                        <!-- Search Bar removed -->
                        <div class="d-none d-lg-flex flex-grow-1"></div>

                        <ul class="navbar-nav mb-3 mb-lg-0 d-none d-lg-flex">
                            <li class="nav-item">
                                <a class="btn btn-dark rounded-pill px-4 shadow-sm" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> بازگشت به سایت
                                </a>
                            </li>
                        </ul>

                        <!-- Mobile Navigation Links (Hidden on md and up) -->
                        <ul class="navbar-nav d-md-none border-bottom pb-3 mb-3 gap-2 mt-3">
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active fw-bold text-primary" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-grid-1x2 me-1"></i> داشبورد
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Properties" ? "active fw-bold text-primary" : "")" asp-area="Admin" asp-controller="Properties" asp-action="Index">
                                    <i class="bi bi-building me-1"></i> مدیریت املاک
                                </a>
                            </li>
                        </ul>

                    </div>
                </div>
            </nav>
        </header>

        <div class="container-fluid">
            <div class="row">
                <!-- Sidebar -->
                <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block sidebar collapse border-end" style="background-color: #f8f9fa;">
                    <div class="position-sticky pt-3 d-flex flex-column" style="top: 80px; height: calc(100vh - 80px);">
                        <ul class="nav flex-column mb-auto">
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-grid-1x2"></i> داشبورد
                                </a>
                            </li>
                            <li class="nav-item mt-2">
                                <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-4 mt-4 mb-2 text-muted fs-7 text-uppercase">
                                    <span>مدیریت</span>
                                </h6>
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Properties" ? "active" : "")" asp-area="Admin" asp-controller="Properties" asp-action="Index">
                                    <i class="bi bi-building"></i> املاک
                                </a>
                            </li>
                        </ul>
                    </div>
                </nav>

                <!-- Main Content -->
                <main class="col-md-9 ms-sm-auto col-lg-10 px-4 px-lg-5 pt-4 admin-content pb-5" style="margin-top: 80px;">
                    @RenderBody()
                </main>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>