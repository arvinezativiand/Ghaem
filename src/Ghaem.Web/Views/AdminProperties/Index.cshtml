@model IEnumerable<Ghaem.Web.Models.Entities.Property>
@{
    ViewData["Title"] = "مدیریت املاک";
    Layout = "_AdminLayout";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>مدیریت املاک</h2>
    <a asp-action="Create" class="btn btn-success">افزودن ملک جدید</a>
</div>

<table class="table table-striped table-hover mt-3">
    <thead>
        <tr>
            <th>تصویر</th>
            <th>عنوان</th>
            <th>معامله</th>
            <th>متراژ</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.Images != null && item.Images.Any())
                    {
                        var primaryImage = item.Images.OrderBy(i => i.DisplayOrder).FirstOrDefault(i => i.IsCover) ?? item.Images.FirstOrDefault();
                        <img src="~/images/properties/@primaryImage.FileName" alt="تصویر ملک" class="img-thumbnail" style="max-width: 100px; max-height: 100px; object-fit: cover;" />
                    }
                    else
                    {
                        <span class="text-muted">بدون تصویر</span>
                    }
                </td>
                <td>@item.Title</td>
                <td>@item.TransactionType.GetDisplayName()</td>
                <td>@item.Area</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">ویرایش</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
