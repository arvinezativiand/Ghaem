<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - پنل مدیریت</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <!-- Header -->
    <header>
        <nav class="navbar navbar-expand-lg admin-navbar fixed-top">
            <div class="container-fluid px-4 align-items-center">
                <!-- Top Brand -->
                <a class="navbar-brand d-flex align-items-center" asp-controller="Admin" asp-action="Index" style="width: 250px;">
                    <div class="avatar-circle bg-dark text-white d-flex align-items-center justify-content-center me-2">
                        <i class="bi bi-shield-check fs-5"></i>
                    </div>
                    داشبورد مدیریت
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="adminNavbarContent">
                    <!-- Search Bar -->
                    <div class="d-none d-lg-flex flex-grow-1 justify-content-center">
                        <div class="admin-search d-flex align-items-center">
                            <i class="bi bi-search text-muted ms-2"></i>
                            <input type="text" placeholder="جستجو در املاک..." />
                        </div>
                    </div>
                    
                    <!-- Top Right Actions -->
                    <ul class="navbar-nav ms-auto align-items-center gap-3">
                        <li class="nav-item">
                            <a class="btn btn-dark rounded-pill px-4" asp-controller="AdminProperties" asp-action="Create">
                                افزودن ملک
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-light rounded-circle shadow-sm border p-2 text-muted" asp-controller="Home" asp-action="Index" target="_blank" title="مشاهده سایت">
                                <i class="bi bi-display"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-light rounded-circle shadow-sm border p-2 text-muted" title="خروج">
                                    <i class="bi bi-box-arrow-right"></i>
                                </button>
                            </form>
                        </li>
                        <li class="nav-item border-start ps-3 ms-1 d-flex align-items-center">
                            <img src="/images/avatar-placeholder.png" onerror="this.src='https://ui-avatars.com/api/?name=Admin&background=random'" alt="Admin" class="avatar-circle" />
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block sidebar collapse h-100 position-fixed" style="top: 80px; right: 0;">
                <div class="position-sticky pt-3 h-100 d-flex flex-column">
                    <ul class="nav flex-column mb-auto">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-grid-1x2"></i> داشبورد
                            </a>
                        </li>
                        <li class="nav-item mt-2">
                            <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-4 mt-4 mb-2 text-muted fs-7 text-uppercase">
                                <span>مدیریت</span>
                            </h6>
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminProperties" ? "active" : "")" asp-controller="AdminProperties" asp-action="Index">
                                <i class="bi bi-building"></i> املاک
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-muted" href="#">
                                <i class="bi bi-people"></i> مشتریان (بزودی)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-muted" href="#">
                                <i class="bi bi-wallet2"></i> مالی (بزودی)
                            </a>
                        </li>
                    </ul>
                    
                    <div class="px-4 pb-4 mt-auto">
                        <div class="p-3 bg-light rounded-3 text-center border">
                            <i class="bi bi-lightning-charge text-warning fs-3"></i>
                            <h6 class="mt-2 mb-1 fw-bold">نسخه پرو</h6>
                            <p class="fs-7 text-muted mb-0">ارتقا به نسخه حرفه‌ای</p>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="col-md-9 me-sm-auto col-lg-10 px-md-4 admin-content" style="margin-top: 80px;">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
