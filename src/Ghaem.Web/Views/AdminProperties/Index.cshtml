@model IEnumerable<Ghaem.Web.Models.Entities.Property>
@{
    ViewData["Title"] = "مدیریت املاک";
    Layout = "_AdminLayout";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>مدیریت املاک</h2>
    <a asp-action="Create" class="btn btn-success">افزودن ملک جدید</a>
</div>

<table class="table table-striped table-hover mt-3">
    <thead>
        <tr>
            <th>کد</th>
            <th>عنوان</th>
            <th>نوع</th>
            <th>معامله</th>
            <th>متراژ</th>
            <th>وضعیت</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Title</td>
                <td>@item.PropertyType</td>
                <td>@item.TransactionType</td>
                <td>@item.Area</td>
                <td>
                    <span class="badge @(item.Status == Ghaem.Web.Models.Enums.PropertyStatus.Available ? "bg-success" : "bg-secondary")">
                        @item.Status
                    </span>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">ویرایش</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
