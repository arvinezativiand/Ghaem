@model IEnumerable<Ghaem.Web.Models.Entities.Property>
@{
    ViewData["Title"] = "صفحه اصلی";
}

<!-- Hero Section with Tabbed Search -->
<div class="hero-section text-center">
    <div class="container-xl position-relative z-index-1">
        <h1 class="hero-title text-white shadow-sm">خانه رویایی خود را پیدا کنید</h1>
        
        <div class="search-container mt-5 shadow-lg">
            <form method="get" asp-action="Properties" class="search-input-group m-0" id="heroSearchForm">
                <input type="text" name="search" placeholder="جستجو کنید..." class="form-control rounded-0" />
                <button type="submit">
                    <i class="bi bi-search"></i>
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Main Container for Properties -->
<div class="container-xl mt-5 pt-3">
    
    <div class="properties-desktop-border mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h4 mb-0 fw-bold">املاک ویژه</h2>
        </div>

        <!-- Properties Grid -->
        <div class="row g-4 mb-4">
        @foreach (var item in Model)
        {
            var coverImg = item.Images.OrderBy(i => i.DisplayOrder).FirstOrDefault(i => i.IsCover) ?? item.Images.FirstOrDefault();
            var imgSrc = coverImg != null ? $"/images/properties/{coverImg.FileName}" : "/images/no-image.jpg";
            
            <div class="col-md-6 col-lg-4">
                <a asp-action="PropertyDetails" asp-route-slug="@item.Slug" class="text-decoration-none">
                    <div class="property-card">
                        <div class="img-wrapper mb-3">
                            <span class="badge-compass">
                                @item.TransactionType.GetDisplayName()
                            </span>
                            <img src="@imgSrc" class="card-img-top w-100" alt="@item.Title">
                        </div>
                        <div class="card-body pt-3 px-3 pb-3">
                            <h5 class="fw-bold text-dark text-truncate mb-2" title="@item.Title">@item.Title</h5>
                            <div class="property-price">
                                @if (item.TransactionType == Ghaem.Web.Models.Enums.TransactionType.Sale)
                                {
                                    <text>@item.SalePrice?.ToString("N0") تومان</text>
                                }
                                else
                                {
                                    if (item.MonthlyRent.HasValue && item.MonthlyRent.Value > 0)
                                    {
                                        <div class="d-flex flex-column">
                                            <span>@item.Deposit?.ToString("N0") تومان <span class="fs-6 fw-normal text-muted">رهن</span></span>
                                            <span class="fs-5 mt-1">@item.MonthlyRent?.ToString("N0") تومان <span class="fs-6 fw-normal text-muted">اجاره</span></span>
                                        </div>
                                    }
                                    else
                                    {
                                        <text>@item.Deposit?.ToString("N0") تومان <span class="fs-6 fw-normal text-muted">(رهن کامل)</span></text>
                                    }
                                }
                            </div>
                            <div class="property-meta fw-bold">
                                @item.BedroomCount خواب 
                                <span class="mx-2 text-muted fw-normal">|</span> 
                                @item.Area.ToString("0") متر مربع 
                                <span class="mx-2 text-muted fw-normal">|</span> 
                                @item.PropertyType.GetDisplayName()
                            </div>
                            <div class="property-address mt-2">
                                @(string.IsNullOrEmpty(item.Address) ? item.Title : item.Address)
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
    
    <!-- Button to see all -->
    <div class="text-center mt-4">
        <a asp-action="Properties" class="btn btn-outline-primary px-5 py-2 fw-bold rounded-0" style="border-width: 2px;">مشاهده تمامی املاک</a>
    </div>
    </div>

    <!-- Informational Section -->
    <div class="row align-items-center mb-5 pb-5">
        <div class="col-lg-6 order-2 order-lg-1 mb-4 mb-lg-0 pe-lg-5">
            <h2 class="fw-bold display-6 mb-4">بهترین املاک اسلامشهر و گلستان</h2>
            <h4 class="fw-bold mb-4">خرید، اجاره و پیش خرید ملک و مغازه</h4>
            <p class="text-secondary fs-5 mb-4">
                املاک قائم با سابقه در ساخت و ساز و خرید و فروش ملک و املاک، شما را تا خانه دار شدن همراهی میکند. برای ارتباط با مشاورین ما تماس بگیرید.
            </p>
            <a asp-action="Contact" class="btn btn-primary px-4 py-2 rounded-0 fw-bold">تماس با مشاورین ما</a>
        </div>
        <div class="col-lg-6 order-1 order-lg-2 mb-4 mb-lg-0">
            <img src="~/images/amlak_ghaem_office.jpg" alt="املاک قائم" class="img-fluid rounded-4 shadow-lg w-100" style="object-fit: cover; max-height: 400px;" />
        </div>
    </div>
</div>

