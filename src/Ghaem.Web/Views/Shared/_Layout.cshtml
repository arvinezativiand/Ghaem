<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - املاک قائم</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav id="mainNavbar" class="navbar navbar-expand-lg public-navbar fixed-top">
            <div class="container-fluid container-xl">
                <!-- Links on the Right (RTL) -->
                <div class="d-none d-lg-flex flex-grow-1">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Properties" asp-route-type="1">خرید</a>
                        </li>
                        <li class="nav-item ms-3">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Properties" asp-route-type="2">اجاره</a>
                        </li>
                        <li class="nav-item ms-3">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Contact">ارتباط با ما</a>
                        </li>
                    </ul>
                </div>

                <!-- Center Logo -->
                <a class="navbar-brand text-uppercase text-center position-absolute start-50 translate-middle-x" asp-area="" asp-controller="Home" asp-action="Index">
                    املاک قائم
                </a>
                
                <!-- Mobile Toggle -->
                <button class="navbar-toggler border-0 shadow-none text-white" type="button" data-bs-toggle="collapse" data-bs-target="#mobileNav">
                    <i class="bi bi-list fs-2"></i>
                </button>

                <!-- Links on the Left (RTL) -->
                <div class="d-none d-lg-flex">
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-3">
                                <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">پنل مدیریت</a>
                            </li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0 d-inline">
                                    <button type="submit" class="nav-link bg-transparent border-0">خروج</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Auth" asp-action="Login">ورود / ثبت‌نام</a>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Mobile Navigation -->
                <div class="collapse navbar-collapse d-lg-none bg-white p-4 position-absolute top-100 start-0 w-100 shadow-lg rounded-bottom" id="mobileNav">
                    <ul class="navbar-nav">
                        <li class="nav-item border-bottom pb-2 mb-2">
                            <a class="nav-link text-dark fw-bold" asp-area="" asp-controller="Home" asp-action="Properties" asp-route-type="1">خرید</a>
                        </li>
                        <li class="nav-item border-bottom pb-2 mb-2">
                            <a class="nav-link text-dark fw-bold" asp-area="" asp-controller="Home" asp-action="Properties" asp-route-type="2">اجاره</a>
                        </li>
                        <li class="nav-item border-bottom pb-2 mb-2">
                            <a class="nav-link text-dark fw-bold" asp-area="" asp-controller="Home" asp-action="Contact">ارتباط با ما</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item border-bottom pb-2 mb-2">
                                <a class="nav-link text-dark fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">پنل مدیریت</a>
                            </li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0">
                                    <button type="submit" class="nav-link bg-transparent border-0 text-dark fw-bold text-start w-100">خروج</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold" asp-area="" asp-controller="Auth" asp-action="Login">ورود / ثبت‌نام</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <!-- No container wrapping render body so hero can be full width -->
    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer-minimal text-center">
        <div class="container-xl">
            <h5 class="fw-bold mb-3">املاک قائم</h5>
            <p class="text-muted mb-4 fs-7">تمامی حقوق برای املاک قائم محفوظ است. کپی‌برداری پیگرد قانونی دارد.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="#" class="text-dark fs-5"><i class="bi bi-instagram"></i></a>
                <a href="#" class="text-dark fs-5"><i class="bi bi-telegram"></i></a>
                <a href="#" class="text-dark fs-5"><i class="bi bi-whatsapp"></i></a>
            </div>
        </div>
    </footer>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Navbar scroll effect
        document.addEventListener("DOMContentLoaded", function () {
            var navbar = document.getElementById('mainNavbar');
            var togglerIcon = document.querySelector('.navbar-toggler i');
            // If on home page (hero exists), make navbar transparent initially
            if (document.querySelector('.hero-section')) {
                window.addEventListener('scroll', function () {
                    if (window.scrollY > 50) {
                        navbar.classList.add('scrolled');
                        togglerIcon.classList.remove('text-white');
                        togglerIcon.classList.add('text-dark');
                    } else {
                        navbar.classList.remove('scrolled');
                        togglerIcon.classList.remove('text-dark');
                        togglerIcon.classList.add('text-white');
                    }
                });
            } else {
                // If not home page, always solid white
                navbar.classList.add('scrolled');
                navbar.classList.remove('public-navbar'); // Remove transparent class completely
                navbar.style.backgroundColor = 'white';
                togglerIcon.classList.remove('text-white');
                togglerIcon.classList.add('text-dark');
                // Ensure links are dark
                var links = document.querySelectorAll('.nav-link, .navbar-brand');
                links.forEach(l => l.style.color = 'black');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
